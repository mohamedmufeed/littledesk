{
  "name": "littledesk-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "LittleDesk - Personal 3D Comic-Style Chrome New Tab Experience",
  "scripts": {
    "build:shared": "pnpm --filter @littledesk/shared build",
    "build:extension": "pnpm --filter @littledesk/extension build",
    "build:api": "pnpm --filter @littledesk/api build",
    "build": "pnpm build:shared && pnpm build:extension && pnpm build:api",
    "dev:extension": "pnpm --filter @littledesk/extension dev",
    "dev:api": "pnpm --filter @littledesk/api dev",
    "dev": "pnpm --parallel dev"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
