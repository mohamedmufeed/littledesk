{
  "manifest_version": 3,
  "name": "LittleDesk - Personal Comic Scrapbook",
  "version": "1.0.0",
  "description": "Personal 3D Comic-Style Scrapbook New Tab Experience with physical notes, checklists, shortcuts, and cloud sync.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:5001/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LittleDesk",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
